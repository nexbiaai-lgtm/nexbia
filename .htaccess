# Crecemia — configuración para Hostinger (Apache)
Options -Indexes
RewriteEngine On

# 1) Una sola dirección: https://www.crecemia.es
# nexbia.es (antigua marca) redirige entera a crecemia.es, página a página.
# Los archivos de verificación de Google se dejan accesibles en nexbia.es.
RewriteCond %{HTTP_HOST} nexbia\.es$ [NC]
RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$ [NC]
RewriteRule ^(.*)$ https://www.crecemia.es/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^crecemia\.es$ [NC]
RewriteRule ^(.*)$ https://www.crecemia.es/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 2) /index.html -> / (una sola dirección para la portada)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 3) Páginas antiguas
RewriteRule ^planes\.html$ /contacto.html [R=301,L]
RewriteRule ^casos-de-exito\.html$ / [R=301,L]
RewriteRule ^digitalizacion\.html$ / [R=301,L]

# Página de error
ErrorDocument 404 /index.html

# Seguridad básica
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# Caché: imágenes 1 año, CSS/JS 1 año (llevan ?v= de versión), HTML sin caché larga
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
